@model IEnumerable<UserPanel.Models.UserNote>

<h2>My Private Dashboard</h2>

<form asp-controller="Account" asp-action="Logout" method="post">
    <button type="submit">Log Out</button>
</form>

<hr />

<h3>Add a Private Note</h3>
<form asp-action="AddNote" method="post">
    <input name="title" placeholder="Note Title" required />
    <input name="content" placeholder="Note Content" required />
    <button type="submit">Save Note</button>
</form>

<h3>My Notes</h3>
<ul>
    @foreach(var note in Model)
    {
        <li>
            <strong>@note.Title</strong> - @note.Content 
            <em>(@note.CreatedAt.ToShortDateString())</em>
        </li>
    }
</ul>